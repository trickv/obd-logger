#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["inotify"]
# ///
"""Import OBD CSV logs into a SQLite database for Grafana.

Watches a log directory via inotify for new/modified obd-*.csv files.
After 30 seconds of inactivity (no more writes), imports all pending
files. This naturally debounces rsync deliveries.

Can also be run as a one-shot import with --once.

Usage:
    ./import-to-sqlite                          # watch mode (default)
    ./import-to-sqlite --once                   # one-shot import and exit
    ./import-to-sqlite /path/to/log /path/to/db # custom paths
"""

import csv
import glob
import os
import re
import sqlite3
import sys
import time
from datetime import datetime
from pathlib import Path

# Parse args: flags first, then positional
args = [a for a in sys.argv[1:] if not a.startswith("-")]
flags = [a for a in sys.argv[1:] if a.startswith("-")]

LOG_DIR = args[0] if len(args) > 0 else os.path.expanduser("~/docker-services/obd/log")
DB_PATH = args[1] if len(args) > 1 else os.path.join(LOG_DIR, "obd.sqlite")
ONE_SHOT = "--once" in flags

DEBOUNCE_SECONDS = 30

NUMERIC_COLUMNS = [
    "rpm", "speed_kmh", "coolant_temp_c", "engine_load_pct",
    "throttle_pct", "intake_temp_c", "maf_gps", "timing_advance_deg",
    "fuel_level_pct", "run_time_sec", "baro_kpa", "fuel_rate_lph",
    "short_fuel_trim_1_pct", "long_fuel_trim_1_pct",
    "ambient_air_temp_c",
    "catalyst_temp_b1s1_c", "catalyst_temp_b2s1_c",
    "elm_voltage", "mpg", "pisugar_battery_pct",
    "poll_time_ms", "sensors_collected", "error_count",
]


def init_db(db):
    db.executescript("""
        CREATE TABLE IF NOT EXISTS readings (
            drive_id       TEXT NOT NULL,
            timestamp      TEXT NOT NULL,
            time_unix      REAL NOT NULL,
            rpm            REAL,
            speed_kmh      REAL,
            coolant_temp_c REAL,
            engine_load_pct REAL,
            throttle_pct   REAL,
            intake_temp_c  REAL,
            maf_gps        REAL,
            timing_advance_deg REAL,
            fuel_level_pct REAL,
            run_time_sec   REAL,
            baro_kpa       REAL,
            fuel_rate_lph  REAL,
            short_fuel_trim_1_pct REAL,
            long_fuel_trim_1_pct  REAL,
            ambient_air_temp_c    REAL,
            catalyst_temp_b1s1_c  REAL,
            catalyst_temp_b2s1_c  REAL,
            elm_voltage    REAL,
            mpg            REAL,
            pisugar_charging INTEGER,
            pisugar_battery_pct REAL,
            poll_time_ms   REAL,
            sensors_collected INTEGER,
            error_count    INTEGER
        );

        CREATE INDEX IF NOT EXISTS idx_readings_drive ON readings(drive_id);
        CREATE INDEX IF NOT EXISTS idx_readings_ts ON readings(timestamp);

        CREATE TABLE IF NOT EXISTS drives (
            drive_id   TEXT PRIMARY KEY,
            filename   TEXT NOT NULL,
            imported_at TEXT NOT NULL,
            row_count  INTEGER NOT NULL
        );
    """)
    # Add device identification columns if they don't exist yet (migration for existing DBs).
    # Denormalized onto readings too so Grafana can filter by device without JOINs.
    for table in ("drives", "readings"):
        for col in ("vin", "bt_mac", "hostname", "wifi_mac"):
            try:
                db.execute(f"ALTER TABLE {table} ADD COLUMN {col} TEXT")
            except sqlite3.OperationalError:
                pass  # column already exists
    # Add new sensor columns to existing DBs (REAL nullable).
    for col in ("short_fuel_trim_1_pct", "long_fuel_trim_1_pct",
                "ambient_air_temp_c",
                "catalyst_temp_b1s1_c", "catalyst_temp_b2s1_c"):
        try:
            db.execute(f"ALTER TABLE readings ADD COLUMN {col} REAL")
        except sqlite3.OperationalError:
            pass
    # Index for Grafana device filtering
    try:
        db.execute("CREATE INDEX IF NOT EXISTS idx_readings_bt_mac ON readings(bt_mac)")
    except sqlite3.OperationalError:
        pass
    # Continuous PiSugar telemetry — captured even when the car is off, so
    # battery discharge during long stops is visible. Cron-fed from the Pi
    # via pisugar-logger; one row per minute per host.
    db.executescript("""
        CREATE TABLE IF NOT EXISTS pisugar_readings (
            timestamp   TEXT NOT NULL,
            time_unix   REAL NOT NULL,
            hostname    TEXT,
            wifi_mac    TEXT,
            battery_pct REAL,
            charging    INTEGER
        );
        CREATE INDEX IF NOT EXISTS idx_pisugar_time ON pisugar_readings(time_unix);
    """)
    # Migration: add wifi_mac to existing pisugar_readings tables.
    try:
        db.execute("ALTER TABLE pisugar_readings ADD COLUMN wifi_mac TEXT")
    except sqlite3.OperationalError:
        pass
    # Unique index on (wifi_mac, timestamp) — wifi_mac is the durable per-Pi
    # identifier, hostnames can collide or be reassigned. Drop the older
    # (hostname, timestamp) index if it's still around.
    try:
        db.execute("DROP INDEX IF EXISTS idx_pisugar_host_ts")
    except sqlite3.OperationalError:
        pass
    try:
        db.execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_pisugar_mac_ts ON pisugar_readings(wifi_mac, timestamp)")
    except sqlite3.OperationalError:
        pass


def parse_csv_metadata(csv_path):
    """Read # comment lines at the top of a CSV and return metadata dict."""
    metadata = {}
    with open(csv_path) as f:
        for line in f:
            if line.startswith("#"):
                # Parse "# KEY: VALUE" lines
                content = line.lstrip("#").strip()
                if ": " in content:
                    key, value = content.split(": ", 1)
                    metadata[key.strip()] = value.strip()
            else:
                break
    return metadata


def import_csv(db, csv_path):
    filename = os.path.basename(csv_path)
    # drive_id is the filename without extension, e.g. "obd-20260306-164722-001DA50362B2"
    drive_id = os.path.splitext(filename)[0]

    # Parse metadata comments at top of CSV
    metadata = parse_csv_metadata(csv_path)
    vin = metadata.get("VIN")
    # Older obd-logger versions wrote VIN as repr(bytearray); unwrap to bare 17 chars.
    if vin:
        m = re.match(r"^bytearray\(b'([^']+)'\)$", vin)
        if m:
            vin = m.group(1)
    bt_mac = metadata.get("BT_MAC")
    hostname = metadata.get("HOSTNAME")
    wifi_mac = metadata.get("WIFI_MAC")

    # Check if already imported
    existing = db.execute(
        "SELECT row_count FROM drives WHERE drive_id = ?", (drive_id,)
    ).fetchone()

    # Count data rows (exclude header, comment lines, and blank lines from corruption)
    with open(csv_path) as f:
        file_rows = sum(1 for line in f if line.strip() and not line.startswith("#")) - 1
    if file_rows <= 0:
        return 0

    if existing and existing[0] >= file_rows:
        return 0  # already fully imported

    # Delete any partial import and re-import
    if existing:
        db.execute("DELETE FROM readings WHERE drive_id = ?", (drive_id,))
        db.execute("DELETE FROM drives WHERE drive_id = ?", (drive_id,))

    rows_inserted = 0
    skipped = 0
    with open(csv_path, newline="", errors="replace") as f:
        # Strip NUL bytes from corrupt CSVs (filesystem corruption on unclean shutdown)
        # and skip comment lines (metadata headers) before passing to DictReader
        clean_lines = (line.replace("\x00", "") for line in f if not line.startswith("#"))
        reader = csv.DictReader(clean_lines)
        for row in reader:
            ts = row.get("timestamp", "")
            try:
                time_unix = datetime.fromisoformat(ts).timestamp()
            except (ValueError, TypeError):
                skipped += 1
                continue
            values = {"drive_id": drive_id, "timestamp": ts, "time_unix": time_unix,
                      "vin": vin, "bt_mac": bt_mac,
                      "hostname": hostname, "wifi_mac": wifi_mac}

            for col in NUMERIC_COLUMNS:
                raw = row.get(col, "")
                if raw == "":
                    values[col] = None
                else:
                    try:
                        values[col] = float(raw)
                    except ValueError:
                        values[col] = None

            # pisugar_charging: "True"/"False"/""  -> 1/0/NULL
            charging = row.get("pisugar_charging", "")
            if charging == "True":
                values["pisugar_charging"] = 1
            elif charging == "False":
                values["pisugar_charging"] = 0
            else:
                values["pisugar_charging"] = None

            columns = list(values.keys())
            placeholders = ", ".join(":" + c for c in columns)
            col_names = ", ".join(columns)
            db.execute(f"INSERT INTO readings ({col_names}) VALUES ({placeholders})", values)
            rows_inserted += 1

    if skipped:
        print(f"  WARNING: skipped {skipped} corrupt rows in {filename}")

    # Store file_rows (not rows_inserted) so the idempotency check converges even
    # when some rows have unparseable timestamps — otherwise we re-import forever.
    db.execute(
        "INSERT INTO drives (drive_id, filename, imported_at, row_count, vin, bt_mac, hostname, wifi_mac) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
        (drive_id, filename, datetime.now().isoformat(), file_rows, vin, bt_mac, hostname, wifi_mac),
    )

    return rows_inserted


def import_pisugar_csv(db, csv_path):
    """Import new rows from pisugar.csv (single ever-growing file).

    Dedups by (hostname, timestamp) via the unique index — duplicates are
    silently dropped, so we can simply re-scan the whole file each run.
    """
    rows_inserted = 0
    with open(csv_path, newline="", errors="replace") as f:
        reader = csv.DictReader(line.replace("\x00", "") for line in f)
        for row in reader:
            ts = row.get("timestamp", "")
            try:
                time_unix = datetime.fromisoformat(ts).timestamp()
            except (ValueError, TypeError):
                continue
            try:
                bat = float(row.get("battery_pct", "") or "")
            except ValueError:
                bat = None
            charging_raw = row.get("charging", "")
            if charging_raw == "True":
                charging = 1
            elif charging_raw == "False":
                charging = 0
            else:
                charging = None
            try:
                db.execute(
                    "INSERT INTO pisugar_readings (timestamp, time_unix, hostname, wifi_mac, battery_pct, charging) VALUES (?, ?, ?, ?, ?, ?)",
                    (ts, time_unix, row.get("hostname", ""), row.get("wifi_mac", ""), bat, charging),
                )
                rows_inserted += 1
            except sqlite3.IntegrityError:
                pass  # already imported (unique index)
    return rows_inserted


def run_import():
    db = sqlite3.connect(DB_PATH)
    init_db(db)

    csv_files = sorted(glob.glob(os.path.join(LOG_DIR, "obd-*.csv")))
    total = 0
    for csv_path in csv_files:
        count = import_csv(db, csv_path)
        if count > 0:
            name = os.path.basename(csv_path)
            print(f"  {name}: {count} rows")
            total += count

    pisugar_csv = os.path.join(LOG_DIR, "pisugar.csv")
    if os.path.exists(pisugar_csv):
        count = import_pisugar_csv(db, pisugar_csv)
        if count > 0:
            print(f"  pisugar.csv: {count} rows")
            total += count

    db.commit()
    db.close()

    if total > 0:
        print(f"Imported {total} rows into {DB_PATH}")
    else:
        print("Nothing new to import.")


def watch():
    import inotify.adapters

    print(f"Watching {LOG_DIR} for CSV changes (debounce={DEBOUNCE_SECONDS}s)")

    # Import anything already pending on startup
    run_import()

    i = inotify.adapters.Inotify()
    i.add_watch(LOG_DIR)

    last_event_time = None

    while True:
        # Poll with a 1-second timeout so we can check the debounce timer
        for event in i.event_gen(timeout_s=1, yield_nones=False):
            (_, type_names, path, filename) = event
            is_obd = filename.startswith("obd-") and filename.endswith(".csv")
            is_pisugar = filename == "pisugar.csv"
            if not (is_obd or is_pisugar):
                continue
            if any(t in type_names for t in ("IN_CLOSE_WRITE", "IN_MOVED_TO", "IN_MODIFY")):
                last_event_time = time.monotonic()
                print(f"Change detected: {filename}")

        # Check if debounce period has elapsed
        if last_event_time is not None:
            elapsed = time.monotonic() - last_event_time
            if elapsed >= DEBOUNCE_SECONDS:
                print(f"No activity for {DEBOUNCE_SECONDS}s, importing...")
                run_import()
                last_event_time = None


if __name__ == "__main__":
    if ONE_SHOT:
        run_import()
    else:
        watch()
